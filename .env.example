# Canonical origin used for metadata, sitemap and structured data.
# Optional on Vercel (VERCEL_PROJECT_PRODUCTION_URL is used automatically);
# set it once a custom domain is live, e.g. https://manavp.is-a.dev
NEXT_PUBLIC_SITE_URL=

# Optional, cookie-free analytics (Plausible). Leave empty to load nothing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only needed for a self-hosted Plausible instance.
NEXT_PUBLIC_PLAUSIBLE_SRC=
